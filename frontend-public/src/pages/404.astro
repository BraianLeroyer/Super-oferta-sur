---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import StaticNav from '../components/StaticNav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Página no encontrada | Super Oferta Sur">
  <StaticNav />

  <main class="min-h-[75vh] flex items-center justify-center bg-slate-50 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full text-center space-y-8 bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50">
      
      {/* Visual Badge / Icon */}
      <div class="relative mx-auto w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-red-50 via-slate-50 to-red-100/50 border-2 border-red-100 flex items-center justify-center shadow-inner">
        <span class="text-4xl sm:text-5xl select-none">🛒</span>
        <span class="absolute -top-2 -right-2 bg-anonima-red text-white text-[11px] font-black px-2.5 py-0.5 rounded-full shadow-md">
          404
        </span>
      </div>

      {/* Heading & Text */}
      <div class="space-y-3">
        <span class="text-xs font-black uppercase tracking-widest text-anonima-red">
          Error 404 · Enlace no encontrado
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
          ¡Ups! Esta oferta ya no está en la góndola
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-sm mx-auto">
          La página que buscás no existe, fue movida o la dirección ingresada no es válida.
        </p>
      </div>

      {/* Action Buttons */}
      <div class="space-y-3 pt-2">
        <a
          href="/"
          class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 bg-anonima-red hover:bg-anonima-darkred text-white text-xs sm:text-sm font-black rounded-2xl shadow-lg shadow-red-900/20 active:scale-95 transition-all"
        >
          🛒 Ir al Catálogo de Ofertas
        </a>
        <div class="grid grid-cols-2 gap-2.5">
          <a
            href="/sucursales"
            class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors"
          >
            📍 Ver Sucursales
          </a>
          <a
            href="/sobre-nosotros"
            class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors"
          >
            💡 Sobre Nosotros
          </a>
        </div>
      </div>

      {/* Help Note */}
      <p class="text-[11px] text-slate-400">
        ¿Buscabas comparar precios? Podés filtrar por comercio y sucursal desde la pantalla principal.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
