---
// src/components/Footer.astro
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Brand column -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 bg-gradient-to-br from-anonima-red to-anonima-darkred rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg shadow-red-900/40">
            OS
          </div>
          <div>
            <span class="text-lg font-black text-white tracking-tight">
              Ofertas <span class="text-anonima-red">Sur</span>
            </span>
            <p class="text-[10px] text-slate-400 font-semibold">Monitor de Precios de la Patagonia</p>
          </div>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Compará precios actualizados de supermercados y mayoristas por sucursal en Chubut y la Patagonia argentina.
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Actualización constante por sucursal</span>
        </div>
      </div>

      <!-- Navegación -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-200 mb-3">Explorar</h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
              🛒 Catálogo General
            </a>
          </li>
          <li>
            <a href="/sucursales" class="hover:text-white transition-colors flex items-center gap-1.5">
              📍 Sucursales y Localidades
            </a>
          </li>
          <li>
            <a href="/sobre-nosotros" class="hover:text-white transition-colors flex items-center gap-1.5">
              💡 Sobre Nosotros
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal & Contacto -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-200 mb-3">Legal y Contacto</h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/privacidad" class="hover:text-white transition-colors flex items-center gap-1.5">
              🔒 Privacidad y Cookies
            </a>
          </li>
          <li>
            <a href="/terminos" class="hover:text-white transition-colors flex items-center gap-1.5">
              📄 Términos y Condiciones
            </a>
          </li>
          <li class="pt-1">
            <span class="text-slate-400 flex items-center gap-1 text-[11px]">
              ✉️ Contacto: <a href="mailto:contacto@superofertasur.com.ar" class="text-slate-300 hover:text-white underline">contacto@superofertasur.com.ar</a>
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom disclaimer & copyright -->
    <div class="border-t border-slate-800/80 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-slate-400">
      <p class="text-center md:text-left">
        © 2026 <strong>Super Oferta Sur</strong>. Plataforma independiente creada para la comunidad patagónica.
      </p>
      <p class="text-center md:text-right text-[10px] text-slate-400">
        Marcas registradas (La Anónima, Carrefour, Jumbo, Vea, Mas Online, Yaguar) pertenecen a sus respectivos titulares.
      </p>
    </div>
  </div>
</footer>
